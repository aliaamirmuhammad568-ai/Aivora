# Copy this file to .env and fill in your real values.

# Gemini API key: https://aistudio.google.com -> "Get API key" (starts with AIzaSy...)
GEMINI_API_KEY=AIzaSy-your-key-here

# Optional: change the backend port (defaults to 3001)
PORT=3001

# Postgres connection string (neon.tech -> create project -> Connection string)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# URLs (defaults already match this project's dev setup)
API_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Session cookie signing secret - change this to any random string
SESSION_SECRET=change-me-to-a-random-string

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (github.com/settings/developers -> New OAuth App)
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (resend.com/api-keys) - powers real password reset emails
RESEND_API_KEY=
# Sandbox sender (default) only delivers to the email you signed up to Resend
# with. Verify a domain at resend.com/domains, then set this to something
# like "Aivora <noreply@yourdomain.com>" to send to anyone.
RESEND_FROM=Aivora <onboarding@resend.dev>
